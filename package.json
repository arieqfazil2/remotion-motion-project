{
  "name": "unesa-s2-motion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts --no-open",
    "check": "tsc --noEmit",
    "prepare-video": "node scripts/prepare.mjs",
    "render": "node scripts/render.mjs",
    "render:preview": "remotion render src/index.ts MotionPreview out/motion-preview.mp4 --codec=h264 --crf=16",
    "enhance-audio": "node scripts/enhance-audio.mjs",
    "import-captions": "node scripts/import-captions.mjs",
    "extract-transcription-audio": "node scripts/extract-transcription-audio.mjs",
    "check-captions": "node scripts/validate-captions.mjs",
    "test": "node tests/motion-captions.test.mjs"
  },
  "dependencies": {
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/effects": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/motion-blur": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
